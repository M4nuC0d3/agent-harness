{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_project_keys": [
    "PROJECT-SPECIFIC KEYS \u2014 the only two entries below that describe a stack rather than a policy. Everything else is the harness's boundary and should survive adoption unchanged.",
    "sandbox.excludedCommands: the current values (docker, mvn, npm) are the demo project's. Each entry skips the sandbox for the WHOLE shell line, chained commands included \u2014 so remove what you do not need before adding yours. guard.py's chaining check reads this list.",
    "sandbox.network.allowedDomains: the registries the demo's build needs.",
    "They stay inline because settings.json has no import mechanism \u2014 the same reason the project block in AGENTS.md is inline. docs/adopt.md step 5."
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *",
      "mvn *",
      "npm *",
      "find *",
      "ls *",
      "grep *"
    ],
    "enableWeakerNestedSandbox": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "pypi.org",
        "*.pythonhosted.org",
        "crates.io",
        "github.com",
        "*.githubusercontent.com"
      ],
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/.gnupg",
        "~/.docker"
      ],
      "allowWrite": []
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credentials*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(terraform:*)",
      "Bash(kubectl:*)",
      "Bash(npm publish:*)",
      "WebFetch"
    ],
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/trace.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\""
          }
        ]
      }
    ]
  }
}
