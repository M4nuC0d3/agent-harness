{
  "name": "agent-harness",
  "description": "A coordinator plus three roles (researcher, implementer, evaluator) with a session budget, an accident catcher and an audit trace. Stack-agnostic: project facts live in one marked block of AGENTS.md. Enforcement wired for Claude Code.",
  "version": "0.1.3",
  "author": {
    "name": "M4nuC0d3",
    "url": "https://github.com/M4nuC0d3"
  },
  "homepage": "https://github.com/M4nuC0d3/agent-harness",
  "repository": "https://github.com/M4nuC0d3/agent-harness",
  "keywords": [
    "agents",
    "subagents",
    "enforcement",
    "sandbox",
    "template"
  ],
  "agents": [
    "./.claude/agents/evaluator.md",
    "./.claude/agents/implementer.md",
    "./.claude/agents/researcher.md"
  ],
  "skills": [
    "./.claude/skills/"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/preflight.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/trace.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/format.py\""
          }
        ]
      }
    ]
  }
}
